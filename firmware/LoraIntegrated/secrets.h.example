// Copy this file to "secrets.h" (same folder as LoraIntegrated.ino) and fill in YOUR values.
// secrets.h is listed in .gitignore, so it is never committed or zipped by accident.
#pragma once
#define WIFI_SSID  "YOUR_WIFI_NAME"                         // 2.4 GHz only (ESP32 has no 5 GHz)
#define WIFI_PASS  "YOUR_WIFI_PASSWORD"
#define SERVER_URL "http://192.168.X.X:3001/api/telemetry"  // IP of the PC running `npm run server`
#define DEVICE_KEY "pick-a-long-random-key"                 // must equal DEVICE_KEY used to start the server
