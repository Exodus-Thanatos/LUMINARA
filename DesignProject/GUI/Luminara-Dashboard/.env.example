# Copy this file to ".env" (same folder as package.json) and fill it in. NEVER commit ".env" or share it.
# Node reads it automatically when you run "npm run server" (Node 20.12+).

# ---- PostgreSQL (required) ----
# Either one connection string...
DATABASE_URL=postgresql://luminara_app:Luminara12345678@localhost:5432/luminara
# ...or the separate PG* variables (used only when DATABASE_URL is empty):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=luminara
# PGUSER=luminara_app
# PGPASSWORD=CHANGE_ME
# Set to true when the database requires SSL (most hosted PostgreSQL services do).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---- Sessions and cookies ----
SESSION_TTL_HOURS=12
# true  = the session cookie is only sent over HTTPS (use this when people open the site through ngrok https://...).
# false = also works over plain http://localhost. Leave empty to get true when NODE_ENV=production, otherwise false.
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Extra browser origins allowed to call the API (comma separated). Normally empty.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# ---- Initial administrator (read ONLY by "npm run db:seed-admin") ----
# Choose your own values. The password must be at least 10 characters with a letter and a number.
# After the admin exists, delete INITIAL_ADMIN_PASSWORD from this file.
INITIAL_ADMIN_FULL_NAME=Luminara
INITIAL_ADMIN_USERNAME=Lumin 
INITIAL_ADMIN_EMAIL=Luminara@gmail.com
INITIAL_ADMIN_PASSWORD=082504thesis


# ---- Existing receiver settings (unchanged) ----
PORT=3001
DEVICE_KEY=rophil1234
# OFFLINE_AFTER_MS=90000
# STALE_AFTER_MS=60000